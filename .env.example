# 记忆目录（默认 ~/.muse）
# MUSE_HOME=~/.muse
# 审批账本（默认 $MUSE_HOME/muse.db）
# MUSE_DB=/home/me/.muse/muse.db
# 只有这个人能拍板
MUSE_OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 卡片发到哪：会话或私聊二选一
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_USER_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# lark-cli 路径（默认 PATH 里的 lark-cli）
# LARK_CLI=lark-cli
